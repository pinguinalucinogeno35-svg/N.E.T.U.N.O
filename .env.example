# ---- Modo GRÁTIS na Cloudflare (padrão quando não há chaves) ----
# Sem AI_API_KEY/STT_API_KEY/TTS_API_KEY o app usa Workers AI (binding "AI" no wrangler.jsonc)
# para IA e transcrição, e a voz do navegador (pt-BR) para falar. Nenhuma chave necessária.
# Opcional: AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast (melhor, gasta mais da cota grátis)

# ---- IA conversacional (servidor) ----
AI_PROVIDER=anthropic        # workers-ai | anthropic | openai (qualquer API compatível com OpenAI)
AI_API_KEY=
AI_MODEL=                    # vazio = padrão do provedor
# AI_BASE_URL=

# ---- Speech-to-Text (servidor) — padrão: endpoint compatível com OpenAI ----
STT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=pt

# ---- Text-to-Speech (servidor) ----
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=nova
TTS_SPEED=1

# ---- Supabase (obrigatório em produção: login + dados por usuário) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # SOMENTE servidor. Nunca com prefixo NEXT_PUBLIC_

# ---- Segurança ----
# Padrão: true em produção, false em dev. Defina false para dev local sem Supabase.
# JARVIS_REQUIRE_AUTH=false
RATE_LIMIT_PER_MINUTE=30
