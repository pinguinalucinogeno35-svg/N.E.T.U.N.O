# ---- IA conversacional (servidor) ----
AI_PROVIDER=anthropic        # anthropic | openai (qualquer API compatível com OpenAI)
AI_API_KEY=
AI_MODEL=                    # vazio = padrão do provedor
# AI_BASE_URL=

# ---- Speech-to-Text (servidor) — padrão: endpoint compatível com OpenAI ----
STT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=pt

# ---- Text-to-Speech (servidor) ----
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=nova
TTS_SPEED=1

# ---- Supabase (opcional no MVP) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # SOMENTE servidor. Nunca com prefixo NEXT_PUBLIC_

# ---- Segurança ----
JARVIS_REQUIRE_AUTH=false    # true = exige login Supabase nas rotas /api
RATE_LIMIT_PER_MINUTE=30
